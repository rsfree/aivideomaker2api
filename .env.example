# 部署环境变量模板 —— 复制为 .env 后填值（.env 不入库，权限 600，属主 = 容器运行用户 10001）
#
# 变量一共 4 类：镜像版本 / 对外凭据 / 成片出口 / minter。全部在本文件里，没有第二处。

# ── 镜像版本 ────────────────────────────────────────────────────────────────
# 部署时**显式传**：AVM2_IMAGE_TAG=<tag> docker compose up -d --pull always。
# 只决定**业务**镜像；minter 的版本在 docker-compose.yml 里独立钉死（回滚更安全）。
AVM2_IMAGE_TAG=0.1.40
# 宿主回环端口（nginx 反代到这里）。只绑 127.0.0.1。
AVM2_HOST_PORT=39055

# ── 对外凭据 ────────────────────────────────────────────────────────────────
# key 规则：sk- + 二级域名，直接拼，不加前后缀。
AVM2_API_KEY=sk-aivideomaker2api
AVM2_PANEL_PASSWORD=sk-aivideomaker2api
# 官方 REST API key（/api/v1/*）。留空 = 只跑网页会话（免费档）。
AVM_OFFICIAL_API_KEY=

# ── 成片出口 ────────────────────────────────────────────────────────────────
# 1 = 对外直接给上游地址（不替上游扛下载带宽），/v/ 端点仍保留以兼容历史链接。
AVM2_MEDIA_PASSTHROUGH=1
# 填了才会把成片直链换成本服务地址（passthrough=1 时无意义）。
# AVM2_PUBLIC_BASE=https://aivideomaker2api.1task.cn

# ── minter（Turnstile 铸造）─────────────────────────────────────────────────
# 🔴 必设，否则两个容器都起不来（fail-closed）。生成：openssl rand -hex 24
# 同一个值同时喂给 minter 的 MINTER_KEY 与业务的 AVM_MINTER_KEY —— 不存在"两边不一致"。
MINTER_KEY=

# minter 的时区**必须与部署机出口 IP 的地理一致**（缺省 Asia/Tokyo = node-3 出口）。
# 时区不一致时 Cloudflare 会下发交互式挑战 ⇒ 铸造恒失败（服务照常 ready，最难查的一类）。
# AVM2_MINTER_TZ=Asia/Tokyo
# AVM2_MINTER_EGRESS=dc-tokyo
